# IP ou DNS anunciado pelo servidor CORBA (igual a CORBA_PUBLIC_HOST no servidor).
# Tem de ser alcancavel a partir deste cliente pela rede/VPN, nas portas TCP 1050 e 2809.
# Nao use localhost nem um nome Docker quando o cliente estiver noutra maquina.
CORBA_NAME_SERVICE_HOST=<IP_OU_DNS_DO_SERVIDOR>
CORBA_NAME_SERVICE_PORT=1050
